# Server Environment Configuration
# Copy this to .env and fill in real values
# NEVER commit .env to git

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins for the mobile app
# In production, restrict to your app's URL or use RN_LOCALHOST
CORS_ORIGINS=http://localhost:8081,http://10.0.2.2:8081

# yt-dlp binary path
# Windows default after manual install:
# YTDLP_BINARY=C:\Users\HP\AppData\Local\Programs\yt-dlp\yt-dlp.exe
# Or just "yt-dlp" if it's on PATH
YTDLP_BINARY=yt-dlp

# FFmpeg binary path (needed for merging audio+video streams)
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BINARY=ffmpeg

# Download storage directory (absolute path)
# Files are served from here and then deleted after client download
DOWNLOAD_DIR=./downloads

# Temp files during processing
TEMP_DIR=./downloads/temp

# Max concurrent downloads
MAX_CONCURRENT_DOWNLOADS=3

# Max file size allowed (bytes) — 500 MB default
MAX_FILE_SIZE_BYTES=524288000

# Security: Restrict which IPs can call the backend (for SSRF protection)
# In production, only allow your mobile backend or app server
ALLOW_PRIVATE_NETWORK=false

# Logging
LOG_LEVEL=debug

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
