<!-- VidFlow launcher icon BACKGROUND (icon-v2, 2026-10-26).
     Near-black full-bleed background for the adaptive icon.
     The launcher mask (squircle / circle / rounded square) crops this square;
     the squircle shape itself is a launcher mask, not drawn here.
     Gradient uses the aapt:attr form, the only gradient form Android
     VectorDrawable accepts (viewport coordinates, not fractions). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle vertical shading: lighter at the top, near-black at the bottom,
         matching the neomorphic tile shading of the reference image. -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#1E1E24" />
                <item android:offset="0.45" android:color="#101014" />
                <item android:offset="1" android:color="#050506" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- GLOSS (revision 2026-10-26, user-approved shine): soft sheen across
         the top of the tile, as on the reference icon — brightest at the
         very top edge, fading smoothly away by ~40dp. This is the full-bleed
         background layer, so the launcher mask crops it; the foreground
         (green circle + arrow) draws over it. -->
    <path android:pathData="M0,0 H108 V42 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="42">
                <item android:offset="0" android:color="#4DFFFFFF" />
                <item android:offset="0.35" android:color="#1AFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
